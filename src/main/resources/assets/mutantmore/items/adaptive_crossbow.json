{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "mutantmore:loaded_ammo",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "fixed",
            "ground"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "mutantmore:item/adaptive_crossbow_loaded_icicle_inventory"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "mutantmore:item/adaptive_crossbow_base_loaded_icicle"
      }
    },
    "on_false": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "scale": 0.025,
        "entries": [
          {
            "threshold": 0.6,
            "model": {
              "type": "minecraft:select",
              "property": "minecraft:display_context",
              "cases": [
                {
                  "when": [
                    "gui",
                    "fixed",
                    "ground"
                  ],
                  "model": {
                    "type": "minecraft:model",
                    "model": "mutantmore:item/adaptive_crossbow_inventory"
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:model",
                "model": "mutantmore:item/adaptive_crossbow_base_pulling_icicle_1"
              }
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "type": "minecraft:select",
              "property": "minecraft:display_context",
              "cases": [
                {
                  "when": [
                    "gui",
                    "fixed",
                    "ground"
                  ],
                  "model": {
                    "type": "minecraft:model",
                    "model": "mutantmore:item/adaptive_crossbow_inventory"
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:model",
                "model": "mutantmore:item/adaptive_crossbow_base_pulling_icicle_2"
              }
            }
          }
        ],
        "fallback": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": [
                "gui",
                "fixed",
                "ground"
              ],
              "model": {
                "type": "minecraft:model",
                "model": "mutantmore:item/adaptive_crossbow_inventory"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "mutantmore:item/adaptive_crossbow_base_pulling_icicle_0"
          }
        }
      },
      "on_false": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": [
              "gui",
              "fixed",
              "ground"
            ],
            "model": {
              "type": "minecraft:model",
              "model": "mutantmore:item/adaptive_crossbow_inventory"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "mutantmore:item/adaptive_crossbow_base"
        }
      }
    }
  }
}
